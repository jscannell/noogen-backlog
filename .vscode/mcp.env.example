# Copy to .vscode/mcp.env and fill in. That copy is gitignored; this one is the template.
#
# The server reads the environment and nothing else — never the CLI's config file, which is state
# belonging to whoever is signed in at that keyboard. See ServerConfig.

# Required. The Backlog Index spreadsheet. `backlog init` creates one; an existing install has the
# id in %APPDATA%\Noogen\backlog.json (~/.config/Noogen/backlog.json on macOS and Linux).
NOOGEN_BACKLOG_SPREADSHEET_ID=

# Who a write is attributed to when the call names no owner. One value for the whole server.
NOOGEN_BACKLOG_OWNER=

# --- Identity: pick one of the two blocks below. ---

# A workstation that has already run `backlog login`. Tokens are encrypted to the OS keystore under
# the account running the debugger, so this only works as that same user.
#   Windows: %APPDATA%\Noogen\credentials
#   macOS / Linux: ~/.config/Noogen/credentials
NOOGEN_BACKLOG_TOKENS=
NOOGEN_BACKLOG_ACCOUNT=default

# A service-account key instead — what a deployed server uses. Set this and it wins outright: the
# two above are not even read.
# NOOGEN_BACKLOG_CREDENTIALS=
