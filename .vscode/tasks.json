{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Noogen.Backlog.slnx", "--nologo"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "build mcp",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Noogen.Backlog.Mcp/Noogen.Backlog.Mcp.csproj", "--nologo"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    }
  ]
}
