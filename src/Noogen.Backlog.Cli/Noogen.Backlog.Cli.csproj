<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Noogen.Backlog.Cli</RootNamespace>
    <AssemblyName>backlog</AssemblyName>

    <!-- Shipped as a global tool so the backlog is reachable from any repo, not just this one.
         See README: dotnet pack -c Release, then dotnet tool install -g. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>backlog</ToolCommandName>
    <PackageId>Noogen.Backlog.Cli</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <Description>Noogen backlog — a WSJF-prioritized Kanban work-item tracker stored in Google Drive.</Description>
  </PropertyGroup>

  <!--
    Bakes the organisation's OAuth client into the tool so an ordinary install needs nothing on
    disk. The source file is gitignored and never committed: the value reaches a build machine
    either as a checked-out-but-ignored file or, in CI, by pointing BacklogOAuthClientFile at a
    secret written to a temporary path.

    Building without it is fine and supported — the tool then falls back to
    %APPDATA%\Noogen\oauth.json or the NOOGEN_BACKLOG_OAUTH_* environment variables, which is what
    a contributor without the secret gets.
  -->
  <PropertyGroup>
    <BacklogOAuthClientFile Condition="'$(BacklogOAuthClientFile)' == ''">$(MSBuildThisFileDirectory)..\..\oauth.json</BacklogOAuthClientFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(BacklogOAuthClientFile)')">
    <EmbeddedResource Include="$(BacklogOAuthClientFile)" LogicalName="oauth.json" Visible="false" />
  </ItemGroup>

  <Target Name="ReportOAuthClientEmbedding" BeforeTargets="CoreCompile">
    <Message Condition="Exists('$(BacklogOAuthClientFile)')" Importance="normal"
             Text="Embedding OAuth client from $(BacklogOAuthClientFile)." />
    <Message Condition="!Exists('$(BacklogOAuthClientFile)')" Importance="normal"
             Text="No OAuth client at $(BacklogOAuthClientFile); the built tool will require oauth.json or NOOGEN_BACKLOG_OAUTH_* at runtime." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Noogen.Backlog\Noogen.Backlog.csproj" />
    <ProjectReference Include="..\Noogen.Backlog.Verbs\Noogen.Backlog.Verbs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noogen.Backlog.Tests" />
  </ItemGroup>

</Project>
