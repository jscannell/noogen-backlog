<Project>

  <!-- Warnings are errors across the whole solution so the build stays clean and regressions
       are caught at compile time rather than accumulating unnoticed.

       Exceptions (kept as warnings, not errors): obsolete-usage diagnostics. Consuming an API
       that has been marked [Obsolete] should surface a warning to nudge migration, but must not
       break the build before we've had a chance to move off it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0612/CS0618/CS0672: use of / override of an [Obsolete] member.
         S1133: SonarAnalyzer "deprecated code should be removed" (fires on our own [Obsolete] decls). -->
    <WarningsNotAsErrors>CS0612;CS0618;CS0672;S1133</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
