<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The text-verb surface: what a caller says to drive the backlog when what they have is words
    rather than method calls. `VerbCatalog` declares every verb and option, `VerbHelp` writes them
    out, and `EmbeddedSkill` carries the guidance that teaches them.

    It is its own assembly rather than a folder in Noogen.Backlog because verbs are not the only
    shape a front end can take. A REST API is resource-shaped — `POST /tickets/{id}/start` is built
    from `BacklogApi` and needs nothing here — so it will reference Noogen.Backlog and skip this
    project entirely. That reference graph is the check: anything in here that the domain library
    turns out to need was misfiled.

    What lives here is therefore command vocabulary, and it says so out loud: options that take a
    value or do not, the file spelling of a prose option, positional arguments, help wrapped to a
    terminal width. None of that belongs above BacklogApi.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Noogen.Backlog\Noogen.Backlog.csproj" />
  </ItemGroup>

  <!--
    Bakes the Claude Code skill in, so `backlog install-skill` can write it into ~/.claude/skills
    and the MCP server can serve the same bytes as resources to a caller with no skills directory.
    It rides here rather than in Noogen.Backlog because the skill teaches these verbs, and here
    rather than in either front end because both serve it — a second embedding would be the second
    copy invariant 16 forbids.

    The source of truth is the repository's own .claude/skills/backlog, not a copy: this is the
    same skill the agents working *on* this repo load, so there is nothing to keep in sync.

    LogicalName gives each file a name of `skill/<relative path>`. %(RecursiveDir) uses the build
    machine's separator, which EmbeddedSkill normalises on the way back out.
  -->
  <PropertyGroup>
    <BacklogSkillDirectory Condition="'$(BacklogSkillDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\.claude\skills\backlog\</BacklogSkillDirectory>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(BacklogSkillDirectory)')">
    <EmbeddedResource Include="$(BacklogSkillDirectory)**\*"
                      LogicalName="skill/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noogen.Backlog.Tests" />
  </ItemGroup>

</Project>
